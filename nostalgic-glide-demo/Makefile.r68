
CC=m68k-apple-macos-gcc
CXX=m68k-apple-macos-g++
AR=m68k-apple-macos-ar
RANLIB=m68k-apple-macos-ranlib
#CC=powerpc-apple-macos-gcc
#CXX=powerpc-apple-macos-g++
#AR=powerpc-apple-macos-ar
#RANLIB=powerpc-apple-macos-ranlib

#CFLAGS= -I../include
CFLAGS= -I..

LDFLAGS=-lOpenGlLibrary -lOpenGLUtility -lm

SDLLIBS=-lSDL
GLIDELIBS=-L.. -lglide2x 

SDLMAIN=../../SDL-1.2-main/obj/SDL_main.c.o


OBJS=$(subst .c,.o,$(wildcard *.c))

.c.o:
	$(CC) $(CFLAGS) -c -o $@ $<


nostalgicglidedemo: $(OBJS)
	$(CXX) -o nostalgicglidedemo.code.bin $(SDLMAIN) $(OBJS) $(GLIDELIBS) $(SDLLIBS) $(LDFLAGS)
	../bin2app.sh nostalgicglidedemo

clean:
	rm -f *.o *.a *.APPL *.dsk *.xcoff *.pef *.bin *.gdb nostalgicglidedemo
