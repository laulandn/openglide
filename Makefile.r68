
all: $(OBJS)
	make -f Makefile.r68 -C src
	cp */*.a .
	cp src/glide.h src/sdk2_*.h .
	make -f Makefile.r68 -C test
	make -f Makefile.r68 -C gldemo
	make -f Makefile.r68 -C nostalgic-glide-demo

clean:
	make -f Makefile.r68 -C src clean
	make -f Makefile.r68 -C test clean
	make -f Makefile.r68 -C gldemo clean
	make -f Makefile.r68 -C nostalgic-glide-demo clean
	rm -f *.a *.h
