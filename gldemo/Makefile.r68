
CC=m68k-apple-macos-gcc
CXX=m68k-apple-macos-g++
AR=m68k-apple-macos-ar
RANLIB=m68k-apple-macos-ranlib
#CC=powerpc-apple-macos-gcc
#CXX=powerpc-apple-macos-g++
#AR=powerpc-apple-macos-ar
#RANLIB=powerpc-apple-macos-ranlib

#CFLAGS= -I../include
CFLAGS= -I$(HOME)/openglide

LDFLAGS=-lOpenGlLibrary -lOpenGLUtility -lm

SDLLIBS=-lSDL
GLIDELIBS=-L$(HOME)/openglide -lglide2x 

SDLMAIN=$(HOME)/SDL-1.2-main/obj/SDL_main.c.o


OBJS=$(subst .c,.o,$(wildcard *.c))

.c.o:
	$(CC) $(CFLAGS) -c -o $@ $<


GlideDemo: GlideDemo.o
	$(CXX) -o GlideDemo.code.bin $(SDLMAIN) GlideDemo.o $(GLIDELIBS) $(SDLLIBS) $(LDFLAGS)
	$(HOME)/sdl2macos9/bin2app.sh GlideDemo

clean:
	rm -f *.o *.a *.APPL *.dsk *.xcoff *.pef *.bin *.gdb
